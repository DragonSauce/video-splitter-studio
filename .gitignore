# ---------------------------------------------------------------------------
# 请勿提交：会让仓库变大或被滥用
# ---------------------------------------------------------------------------

# 私钥：任何拿到它的人都能伪造"本程序签名"，绝不能上传
*.pfx
*.pvk
*.p12

# 打包产物（378 MB，对方应该自己 build_exe.py 生成）
dist/
build/
.build_tools/

# 第三方依赖（用 fetch_deps.py 拉取）
vendor/

# FFmpeg 二进制（每个 100 MB，超过 GitHub 的 100 MB 单文件上限）
bin/
*.exe
# 但程序图标必须入库：打包和窗口图标都靠它
!app.ico
# 公开证书要入库：别人靠它验证签名（私钥 *.pfx 已排除）
!*.cer

# 测试与演示素材（自己生成的视频/图片）
testmedia/

# 发布附件：这个文件夹放的是打包好的成品 zip（145 MB，超 GitHub 单文件上限），
# 它要传到仓库页面的 Releases 里当附件，而不是提交进源码
releases/

# 运行期生成
cache/
shots/
selftest.log
*.log

# 本地开发台账（含本机路径与证书指纹，只对我自己有意义）
HANDOFF.md

# 生成物
__pycache__/
*.py[cod]
*.egg-info/
.tmp/
shot_out.txt
shot_err.txt

# 打包时生成（build_exe.py 会重写，不入库）
VideoSplitterStudio.spec
version_info.txt
